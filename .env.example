# Chave da API da Anthropic (https://console.anthropic.com/settings/keys).
# Opcional: sem ela o bot usa só as palavras-chave, e o que ele não reconhecer vai pra "Outros".
ANTHROPIC_API_KEY=

# Modelo usado para categorizar o que as palavras-chave não pegam.
# CLAUDE_MODEL=claude-opus-5-5

# Opcional: em vez do QR code, gera um código de 8 letras para digitar no celular.
# Formato: código do país + DDD + número, só dígitos. Ex: 5511999998888
# WHATSAPP_NUMERO=

# Quando mandar o relatório mensal (padrão: dia 1º às 9h)
# RELATORIO_CRON=0 9 1 * *
